s="geometry"/></mxCell><mxCell id="arq12" value="&lt;b&gt;GitHub Actions&lt;/b&gt;&lt;br&gt;• CI (build + testes)&lt;br&gt;• Publicar site (prerender + wrangler)&lt;br&gt;• Deploy API (OIDC → Azure)&lt;br&gt;• Backup noturno pg_dump → R2" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;strokeWidth=1.5;fillColor=#F3F3F3;strokeColor=#24292F;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="850" y="125" width="270" height="120" as="geometry"/></mxCell><mxCell id="arq13" value="&lt;b&gt;Monorepo&lt;/b&gt;&lt;br&gt;/frontend · /backend · /infra" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;strokeWidth=1.5;fillColor=#F3F3F3;strokeColor=#24292F;" vertex="1" parent="1"><mxGeometry x="1160" y="125" width="210" height="60" as="geometry"/></mxCell><mxCell id="arq14" value="&lt;b&gt;GHCR&lt;/b&gt;&lt;br&gt;imagem Docker chiseled" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;strokeWidth=1.5;fillColor=#F3F3F3;strokeColor=#24292F;" vertex="1" parent="1"><mxGeometry x="1160" y="225" width="210" height="60" as="geometry"/></mxCell><mxCell id="arq15" value="Azure Container Apps (consumo)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;strokeWidth=2;dashed=1;dashPattern=8 4;container=0;fillColor=#F5F9FE;strokeColor=#0078D4;" vertex="1" parent="1"><mxGeometry x="820" y="400" width="330" height="220" as="geometry"/></mxCell><mxCell id="arq16" value="&lt;b&gt;ASP.NET Core Minimal API&lt;/b&gt;&lt;br&gt;.NET 10 · scale-to-zero&lt;br&gt;&lt;br&gt;EF Core · FluentValidation&lt;br&gt;ProblemDetails · OpenTelemetry" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;strokeWidth=1.5;fillColor=#E8F1FB;strokeColor=#0078D4;" vertex="1" parent="1"><mxGeometry x="850" y="445" width="270" height="140" as="geometry"/></mxCell><mxCell id="arq17" value="&lt;b&gt;Neon Postgres&lt;/b&gt;&lt;br&gt;serverless&lt;br&gt;scale-to-zero" style="shape=c