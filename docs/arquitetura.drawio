</mxCell><mxCell id="arq12" value="&lt;b&gt;Lambda PublishDispatcher&lt;/b&gt;&lt;br&gt;.NET 10 · fora da VPC" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;strokeWidth=1.5;fillColor=#FFF5E6;strokeColor=#FF9900;" vertex="1" parent="1"><mxGeometry x="810" y="130" width="180" height="70" as="geometry"/></mxCell><mxCell id="arq13" value="&lt;b&gt;S3 snapshots&lt;/b&gt;&lt;br&gt;snapshot.json (privado)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;strokeWidth=1.5;fillColor=#FFF5E6;strokeColor=#FF9900;" vertex="1" parent="1"><mxGeometry x="810" y="250" width="180" height="70" as="geometry"/></mxCell><mxCell id="arq14" value="GitHub" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;strokeWidth=2;dashed=1;dashPattern=8 4;container=0;fillColor=#FAFAFA;strokeColor=#24292F;" vertex="1" parent="1"><mxGeometry x="1040" y="90" width="360" height="260" as="geometry"/></mxCell><mxCell id="arq15" value="&lt;b&gt;GitHub Actions&lt;/b&gt; (OIDC → AWS)&lt;br&gt;• CI (build + testes)&lt;br&gt;• publish-site: prerender + s3 sync&lt;br&gt;• deploy-api / deploy-admin" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;strokeWidth=1.5;fillColor=#F3F3F3;strokeColor=#24292F;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1060" y="130" width="320" height="105" as="geometry"/></mxCell><mxCell id="arq16" value="&lt;b&gt;Monorepo&lt;/b&gt;&lt;br&gt;frontend · backend · infra (Terraform)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;strokeWidth=1.5;fillColor=#F3F3F3;strokeColor=#24292F;" vertex="1" parent="1"><mxGeometry x="1180" y="270" width="200" height="60" as="geometry"/></mxCell><mxCell id="arq17" value="AWS — VPC privada (sem NAT Gateway)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;strokeWidth=2;dashed=1;dashPattern=8 4;container=0;fillColor=#F7FBF7;strokeColor=#3F8624;" vertex="1" parent="1"><mxGeometry x="790" y="400" width="610" height="250" as="geometry"/></mxCell><mxCell id="arq18" value="&lt;b&gt;Lambda da API&lt;/b&gt;&lt;br&gt;ASP.NET Core Minimal API · .NET 10 · arm64&lt;br&gt;&lt;br&gt;EF Core · FluentValidation&lt;br&gt;ProblemDetails" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;strokeWidth=1.5;fillColor=#EEF6EE;strokeColor=#3F8624;" vertex="1" parent="1"><mxGeometry x="820" y="445" width="270" height="130" as="geometry"/></mxCell><mxCell id="arq19" value="S3 gateway endpoint (gratuito)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;strokeWidth=1.5;fillColor=#EEF6EE;strokeColor=#3F8624;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="820" y="595" width="270" height="32" as="geometry"/></mxCell><mxCell id="arq20" value="&lt;b&gt;Aurora Serverless v2&lt;/b&gt;&lt;br&gt;PostgreSQL 16&lt;br&gt;0–1 ACU · pausa sozinho" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fontSize=12;strokeWidth=1.5;fillColor=#E8EEFB;strokeColor=#3B48CC;" vertex="1" parent="1"><mxGeometry x="1200" y="450" width="170" height="120" as="geometry"/></mxCell><mxCell id="arq21" value="&lt;b&gt;CloudWatch&lt;/b&gt; (logs 7 dias + alarmes → e-mail)&lt;br&gt;&lt;b&gt;AWS Budgets&lt;/b&gt; (alerta de custo)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#888888;" vertex="1" parent="1"><mxGeometry x="190" y="690" width="400" height="60" as="geometry"/></mxCell><mxCell id="arq22" value="&lt;b&gt;Decisões-chave:&lt;/b&gt; o visitante só acessa conteúdo estático no CloudFront — se a API ou o banco pararem, o site continua no ar. A VPC não tem NAT: a API fala só com o Aurora e com o S3 (endpoint gratuito); a chamada ao GitHub sai pela Lambda PublishDispatcher, fora da VPC." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=10;spacingRight=10;fontSize=12;fillColor=#F4EFE6;strokeColor=#3F