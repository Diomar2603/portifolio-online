xCell id="flu2" value="Upload de imagem" style="swimlane;horizontal=0;html=1;startSize=36;fontStyle=1;fontSize=14;rounded=1;arcSize=3;strokeWidth=1.5;fillColor=#F4EFE6;strokeColor=#3F5E4B;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1360" height="210" as="geometry"/></mxCell><mxCell id="flu3" value='&lt;b&gt;&lt;font color="#FF7A59"&gt;1.&lt;/font&gt; Entrada&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Ctrl+V, arrastar e soltar ou &amp;lt;input type=file&amp;gt; — um único handler&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#3F5E4B;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="100" y="125" width="200" height="100" as="geometry"/></mxCell><mxCell id="flu4" value='&lt;b&gt;&lt;font color="#FF7A59"&gt;2.&lt;/font&gt; Web Worker&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;remove EXIF/GPS, redimensiona 480/1200/2400 px, converte para WebP, calcula SHA-256&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#3F5E4B;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="360.0" y="125" width="200" height="100" as="geometry"/></mxCell><mxCell id="flu5" value='&lt;b&gt;&lt;font color="#FF7A59"&gt;3.&lt;/font&gt; POST /api/admin/media&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;API deduplica pelo hash e devolve URLs pré-assinadas (5 min)&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#3F5E4B;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="620.0" y="125" width="200" height="100" as="geometry"/></mxCell><mxCell id="flu6" value='&lt;b&gt;&lt;font color="#FF7A59"&gt;4.&lt;/font&gt; PUT direto no R2&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;o navegador envia cada variante sem passar pela API&lt;/span&gt;' style="rounded=1